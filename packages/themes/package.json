{
  "name": "@thebuilder/deckard-themes",
  "version": "0.1.0",
  "description": "The deck themes behind Deckard, a React presentation framework for Next.js. Each one is a SlideTheme that carries its own stylesheet.",
  "keywords": [
    "deck",
    "presentation",
    "slides",
    "theme"
  ],
  "homepage": "https://github.com/thebuilder/deckard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebuilder/deckard.git"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./*/theme.css": "./dist/*/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-theme-assets.ts",
    "dev": "node scripts/dev.ts",
    "prepack": "tsc --project tsconfig.build.json && node scripts/copy-theme-assets.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@thebuilder/deckard-core": "workspace:*",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@thebuilder/deckard-core": ">=0.0.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
