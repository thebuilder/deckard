{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    ".fallowrc.json",
    "apps/playground/app/slides/blocks/**",
    "apps/playground/deck/theme/**",
    "apps/playground/package.json",
    "registry/themes/**"
  ],
  "globalEnv": [
    "NEXT_PUBLIC_PDF_EXPORT",
    "NEXT_PUBLIC_PDF_THEME",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@deckard/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "template/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "dependsOn": ["^build"]
    },
    "//#lint": {
      "cache": false
    },
    "//#lint:check": {
      "cache": false
    },
    "//#analyze": {
      "cache": false
    }
  }
}
