{
  "name": "@deckard/core",
  "version": "0.0.1",
  "description": "The deck contract and the slideshow runtime behind Deckard, a React presentation framework for Next.js.",
  "keywords": [
    "deck",
    "next",
    "presentation",
    "react",
    "slides"
  ],
  "homepage": "https://github.com/thebuilder/next-slideshow-template#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebuilder/next-slideshow-template.git"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./code-block": {
      "types": "./dist/components/code-block.d.ts",
      "default": "./dist/components/code-block.js"
    },
    "./discovery": {
      "types": "./dist/deck/discovery.d.ts",
      "default": "./dist/deck/discovery.js"
    },
    "./next": {
      "types": "./dist/next/routes.d.ts",
      "default": "./dist/next/routes.js"
    },
    "./slide-from-module": {
      "types": "./dist/deck/slide-from-module.d.ts",
      "default": "./dist/deck/slide-from-module.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-theme-assets.ts",
    "dev": "node scripts/copy-theme-assets.ts && tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "test:unit": "vitest run --project node",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.38.0",
    "next-themes": "^0.4.6",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "next": "16.3.3",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
