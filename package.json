{
  "name": "deckard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "fallow",
    "build": "turbo run build",
    "check-overflow": "pnpm deck:check-overflow",
    "cli:build": "turbo run build --filter=@deckard/cli --filter=@deckard/themes",
    "deck:check-overflow": "pnpm cli:build && pnpm --filter playground deck:check-overflow",
    "deck:contact-sheet": "pnpm cli:build && pnpm --filter playground deck:contact-sheet",
    "deck:doctor": "pnpm cli:build && pnpm --filter playground deck:doctor",
    "deck:screenshots": "pnpm cli:build && pnpm --filter playground deck:screenshots",
    "deck:validate": "pnpm cli:build && pnpm --filter playground deck:validate",
    "demo": "turbo run dev --filter=demo...",
    "demo:check-overflow": "pnpm cli:build && pnpm --filter demo deck:check-overflow",
    "demo:contact-sheet": "pnpm cli:build && pnpm --filter demo deck:contact-sheet",
    "demo:doctor": "pnpm cli:build && pnpm --filter demo deck:doctor",
    "demo:export:pdf": "pnpm cli:build && pnpm --filter demo export:pdf",
    "demo:screenshots": "pnpm cli:build && pnpm --filter demo deck:screenshots",
    "demo:validate": "pnpm cli:build && pnpm --filter demo deck:validate",
    "dev": "turbo run dev --filter=playground...",
    "export:pdf": "pnpm cli:build && pnpm --filter playground export:pdf",
    "lint": "ultracite fix --error-on-warnings",
    "lint:check": "ultracite check",
    "registry:build": "shadcn build --output apps/docs/public/r",
    "release:pack": "node tools/release-pack/run.ts",
    "smoke": "pnpm smoke:package && pnpm smoke:registry",
    "smoke:cli": "node tools/cli-smoke/run.ts",
    "smoke:package": "node tools/package-smoke/run.ts",
    "smoke:registry": "node tools/registry-smoke/run.ts",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:browser:install": "pnpm --filter @deckard/core exec playwright install --with-deps chromium firefox webkit",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm deck:validate && pnpm demo:validate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "fallow": "^3.21.0",
    "shadcn": "^4.19.1",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7"
  },
  "packageManager": "pnpm@10.18.1"
}
