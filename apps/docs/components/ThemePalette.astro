---
import { readThemeSwatches, swatchTokens } from "../lib/theme-tokens"

interface Props {
  theme: string
}

const { theme } = Astro.props
const { dark, light } = readThemeSwatches(theme)
const modes = [
  { label: "Light", swatches: light },
  { label: "Dark", swatches: dark },
]
---

<div class="not-prose my-6 grid gap-4 sm:grid-cols-2">
  {
    modes.map((mode) => (
      <div class="rounded-blume border border-border p-4">
        <p class="mb-3 font-mono text-muted-foreground text-xs uppercase tracking-widest">
          {mode.label}
        </p>
        <dl class="grid grid-cols-3 gap-3">
          {swatchTokens.map((token) => (
            <div>
              <div
                class="h-10 rounded-blume border border-border"
                style={
                  mode.swatches[token]
                    ? `background:${mode.swatches[token]}`
                    : undefined
                }
                title={mode.swatches[token] ?? "not declared"}
              />
              <dt class="mt-1.5 font-mono text-[0.7rem] text-foreground">
                --{token}
              </dt>
              <dd class="font-mono text-[0.65rem] text-muted-foreground leading-tight">
                {mode.swatches[token] ?? "not declared"}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>
