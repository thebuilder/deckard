---
import { patternGroups, slidePatterns } from "../lib/patterns"
import { previewSrc } from "../lib/preview-src"
import { slidePreviewPath } from "../lib/slide-previews"

interface Props {
  /* Columns on a wide screen. Left out, the grid fits as many as it can. */
  columns?: number
  /* Grouped by job with a label per group, or one run of cards. */
  grouped?: boolean
}

const { columns, grouped = false } = Astro.props

const sections = grouped
  ? patternGroups.map((group) => ({
      group,
      items: slidePatterns.filter((item) => item.group === group),
    }))
  : [{ group: null, items: slidePatterns }]
---

<div
  class="patterns not-prose"
  data-columns={columns}
  style={columns ? `--pattern-columns: ${columns}` : undefined}
>
  {
    sections.map((section) => (
      <section class="pattern-section">
        {section.group && <p class="pattern-group">{section.group}</p>}
        <ul class="pattern-grid">
          {section.items.map((item) => (
            <li>
              <a class="pattern-card" href={item.href}>
                <img
                  alt={`The ${item.name.toLowerCase()} pattern in the feature deck`}
                  decoding="async"
                  height="1080"
                  loading="lazy"
                  src={previewSrc(slidePreviewPath(item.previewRoute))}
                  width="1920"
                />
                <span class="pattern-name">{item.name}</span>
                <code class="pattern-component">{item.component}</code>
                <span class="pattern-use">{item.use}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .patterns {
    display: grid;
    gap: 2.5rem;
    margin-block: 2rem;
  }

  .pattern-group {
    margin-block-end: 1rem;
    font-family: var(--blume-font-mono);
    font-size: 0.6875rem;
    color: var(--blume-muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .pattern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1.75rem 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .patterns[data-columns] .pattern-grid {
      grid-template-columns: repeat(var(--pattern-columns), minmax(0, 1fr));
      gap: 2.25rem 1.5rem;
    }
  }

  .pattern-card {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .pattern-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-block-end: 0.625rem;
    object-fit: cover;
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .pattern-card:hover img,
  .pattern-card:focus-visible img {
    border-color: color-mix(in oklch, var(--blume-accent) 55%, transparent);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 55%);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-card img {
      transition: none;
    }

    .pattern-card:hover img,
    .pattern-card:focus-visible img {
      transform: none;
    }
  }

  .pattern-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--blume-foreground);
  }

  .pattern-component {
    justify-self: start;
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    color: var(--blume-accent);
  }

  .pattern-use {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--blume-muted-foreground);
    text-wrap: pretty;
  }
</style>
