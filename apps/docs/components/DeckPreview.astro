---
import "@deckard/core/styles.css"
// One line per built-in, because a bundler needs the specifier written out.
// A theme missing here renders an unstyled card; deck-preview.ts fails the
// build when a shipped theme has no gallery entry, which is the same edit.
import "@deckard/themes/aurora/theme.css"
import "@deckard/themes/blueprint/theme.css"
import "@deckard/themes/ledger/theme.css"
import "@deckard/themes/meridian/theme.css"
import "@deckard/themes/nexus/theme.css"
import "@deckard/themes/phosphor/theme.css"
import "@deckard/themes/quorum/theme.css"
import "../styles/deck-preview.css"
import type {
  BackgroundVariant,
  ColorMode,
  PreviewSlide,
  ThemeName,
} from "../lib/deck-preview"
import { gallerySlide } from "../lib/deck-preview"

interface Props {
  background?: BackgroundVariant
  class?: string
  hidden?: boolean
  id?: string
  mode: ColorMode
  /* The fit a reader with no script gets, so it has to be the stage's narrowest
     width over 1920. Anything larger crops, because the stage clips. */
  scale?: number
  slide?: PreviewSlide
  theme: ThemeName
}

const {
  background = "default",
  class: className,
  hidden,
  id,
  mode,
  scale,
  slide = gallerySlide,
  theme,
} = Astro.props

const canvasStyle = `--canvas-width: 1920px; --canvas-height: 1080px${
  scale === undefined ? "" : `; --deck-preview-scale-default: ${scale}`
}`

const layout = slide.layout ?? "panel"
const figures = slide.figures ?? []
const bullets = slide.bullets ?? []
const showTitle = Boolean(slide.title) && slide.title !== slide.brand
const progress = slide.total > 0 ? slide.number / slide.total : 0
const label = `A ${theme} slide in ${mode} mode, headed "${slide.heading}"`
---

{/*
 * The sample deck copy inside a preview is a demonstration, not documentation,
 * and it must not answer a search or land in llms-full.txt as though it were.
 * Blume's Orama index and its Markdown and llms output are built from each
 * page's source MDX, where this whole component is one self-closing tag, so
 * today they carry none of it. data-pagefind-ignore is the guard for the one
 * path that reads rendered HTML instead: Pagefind, which search.provider can be
 * switched to, honours the attribute on any element.
 *
 * role="img" with aria-label is what keeps the frame named for a screen reader
 * while taking its inner markup out of the accessibility tree.
 */}
<div
  aria-label={label}
  class:list={["deck-preview", className]}
  data-mode={mode}
  data-pagefind-ignore="all"
  data-theme-preview={theme}
  hidden={hidden}
  id={id}
  role="img"
>
  <div
    class:list={["deck-preview-canvas", `${theme}-theme`]}
    data-canvas-height="1080"
    data-canvas-width="1920"
    data-slide-canvas
    data-slide-color-mode={mode}
    data-slide-theme={theme}
    style={canvasStyle}
  >
    <div
      aria-hidden="true"
      class="slide-background"
      data-slide-background={background}
    >
    </div>

    <header class="deck-preview-chrome-top" data-slide-header>
      <span data-slide-header-brand>{slide.brand}</span>
      {showTitle && <span data-slide-header-title>{slide.title}</span>}
      {slide.meta && <span data-slide-header-meta>{slide.meta}</span>}
    </header>

    <main class="deck-preview-frame" data-slide-frame>
      {
        layout === "hero" && (
          <div class="deck-preview-hero">
            <p class="deck-preview-eyebrow">{slide.eyebrow}</p>
            <h2 class="deck-preview-hero-title">{slide.heading}</h2>
            {slide.lead && <p class="deck-preview-hero-lead">{slide.lead}</p>}
          </div>
        )
      }

      {
        layout === "breaker" && (
          <section class="deck-preview-breaker">
            <div class="deck-preview-breaker-body">
              <p class="deck-preview-eyebrow">{slide.eyebrow}</p>
              <h2 class="deck-preview-breaker-title">{slide.heading}</h2>
              {slide.lead && <p class="deck-preview-lead">{slide.lead}</p>}
            </div>
          </section>
        )
      }

      {
        (layout === "panel" ||
          layout === "figures" ||
          layout === "bullets") && (
          <div class="deck-preview-body">
            <div class="deck-preview-intro">
              <p class="deck-preview-eyebrow">{slide.eyebrow}</p>
              <div class="deck-preview-headings">
                <h2 class="deck-preview-heading">{slide.heading}</h2>
                {slide.lead && <p class="deck-preview-lead">{slide.lead}</p>}
              </div>
            </div>

            {layout === "figures" && (
              <div>
                <dl class="deck-preview-stats" data-slide-surface>
                  {figures.map((figure) => (
                    <div class="deck-preview-stat">
                      <dt>{figure.caption}</dt>
                      <dd data-stat-value>
                        {figure.value}
                        {figure.unit && <span>{figure.unit}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {layout === "bullets" && (
              <div>
                <div class="deck-preview-bullets" data-slide-surface>
                  {bullets.map((bullet, index) => (
                    <div>
                      <p class="deck-preview-bullet-index">
                        {String(index + 1).padStart(2, "0")}
                      </p>
                      <p class="deck-preview-bullet-text">{bullet}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {layout === "panel" && (
              <div class="deck-preview-panel" data-slide-panel>
                <dl class="deck-preview-stats deck-preview-stats-flat">
                  {figures.map((figure) => (
                    <div class="deck-preview-stat">
                      <dt>{figure.caption}</dt>
                      <dd data-stat-value>
                        {figure.value}
                        {figure.unit && <span>{figure.unit}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {slide.footnote && (
              <p class="deck-preview-footnote">{slide.footnote}</p>
            )}
          </div>
        )
      }
    </main>

    <footer class="deck-preview-chrome-bottom" data-slide-footer>
      <div
        aria-hidden="true"
        data-slide-progress
        style={`--slide-progress: ${progress}`}
      >
      </div>
      <p data-slide-counter>
        <span data-slide-counter-current>{slide.number}</span><span
          data-slide-counter-separator
        >
          of
        </span><span data-slide-counter-total>{slide.total}</span>
      </p>
    </footer>
  </div>
</div>

<script>
  /*
   * The fit a stage needs is one length over another, which CSS cannot divide
   * portably: Safari's atan2 takes numbers and angles, not lengths, so the trig
   * in deck-preview.css never applies there. SlideViewport measures instead,
   * and so does this. Astro hoists one copy of this module per page, however
   * many previews are on it.
   */
  const canvases = new WeakMap<Element, HTMLElement>()
  const pending = new Map<HTMLElement, number>()
  let frame = 0

  const publish = () => {
    frame = 0

    for (const [canvas, width] of pending) {
      const target = Number(canvas.dataset.canvasWidth)

      // A hidden preview measures zero, and its static default holds until it shows.
      if (width > 0 && target > 0) {
        canvas.style.setProperty("--deck-preview-scale", String(width / target))
      }
    }

    pending.clear()
  }

  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const canvas = canvases.get(entry.target)

      if (canvas !== undefined) {
        pending.set(canvas, entry.contentRect.width)
      }
    }

    if (frame === 0) {
      frame = requestAnimationFrame(publish)
    }
  })

  const observe = () => {
    observer.disconnect()

    for (const canvas of document.querySelectorAll<HTMLElement>(
      "[data-slide-canvas]"
    )) {
      const stage = canvas.parentElement

      if (stage !== null) {
        canvases.set(stage, canvas)
        observer.observe(stage)
      }
    }
  }

  observe()

  // The client router swaps the document without re-running this module.
  document.addEventListener("astro:page-load", observe)
</script>
