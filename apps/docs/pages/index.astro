---
import { Image } from "astro:assets"
import { Code } from "astro:components"
import data from "blume:data"
import PageLayout from "blume/components/layout/PageLayout.astro"
import presenterImage from "../assets/presenter.png"
import HeroBackground from "../components/HeroBackground.astro"
import LiveDeck from "../components/LiveDeck.astro"
import SlidePatterns from "../components/SlidePatterns.astro"
import ThemeGrid from "../components/ThemeGrid.astro"
import type { HeroVariantId } from "../components/hero/hero-effect"
import { canvas, cliCode, demoCode, demoSteps, installCode } from "../lib/landing"
import { playgroundUrl } from "../lib/playground"
import { previewSrc } from "../lib/preview-src"
import { themePreviewPath } from "../lib/slide-previews"
import "../styles/landing.css"

const { config } = data

/* The effect behind the hero. */
const heroVariant: HeroVariantId = "esper-scan"
const canvasSize = `${canvas.width}x${canvas.height}`

/* The theme the example deck opens in at the top of the page. */
const stageTheme = "aurora"

/* The walkthrough and the canvas demonstration show the deck in the default
 * theme, which is the one a new deck starts in. */
const walkthroughTheme = "meridian"

const presenterAlt =
  "The presenter window: a timer and a clock, a preview of the next step, the deck listed by title with the current slide picked out, the slide itself, and the speaker notes under it."

const codeThemes = {
  dark: "github-dark-high-contrast",
  light: "github-light-high-contrast",
} as const

// Shiki emits one <span class="line"> per line. Numbering them is what lets the
// generated rules below light one slide object and dim the rest, with no script.
const numberLines = {
  line(node: { properties: Record<string, unknown> }, line: number) {
    node.properties["data-line"] = String(line)
  },
  name: "deckard-line-number",
}

const lineStep = 26

const stateRules = demoSteps
  .map((step, index) => {
    const id = `#demo-step-${index + 1}`
    const range = `:nth-child(n + ${step.from}):nth-child(-n + ${step.to})`

    const active = `.demo:has(${id}:checked)`

    return [
      `${active} .line:not(${range}) { opacity: 0.38 }`,
      `${active} .demo-slide[data-step="${index + 1}"] { display: block }`,
      // visibility, not display: the captions are stacked in one grid cell, so
      // the hidden ones are what hold the slide above them still.
      `${active} .demo-caption[data-step="${index + 1}"] { visibility: visible }`,
    ].join("\n")
  })
  .join("\n")

// The reveal lives inside the motion query rather than being switched off by a
// later rule, because the generated selectors below outrank anything static.
const motionRules = demoSteps
  .map((step, index) =>
    Array.from(
      { length: step.to - step.from + 1 },
      (_, offset) =>
        `.demo:has(#demo-step-${index + 1}:checked) .line:nth-child(${step.from + offset}) { animation-name: demo-line-in; animation-delay: ${offset * lineStep}ms }`
    ).join("\n")
  )
  .join("\n")

const pageRules = `${stateRules}
@media (prefers-reduced-motion: no-preference) {
${motionRules}
}`
---

<PageLayout
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  ogImage={`${config.site}/social/home.png`}
  ogImageAlt="Deckard. Slides are React components, beside the example deck in three themes."
  ogImageSize={{ height: 630, width: 1200 }}
  page={{
    description: `Build presentations in React from editable slide patterns, with a fixed ${canvasSize} canvas, presenter tools, themes, and PDF export.`,
    title: "Deckard, presentations built with React",
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
>
  <style is:inline set:html={pageRules}></style>

  <div class="landing">
    <section class="hero" data-hero-state="idle" data-hero-variant={heroVariant}>
      <HeroBackground variant={heroVariant} />

      <div class="hero-inner">
        <p class="hero-eyebrow">A presentation framework for Next.js</p>
        <h1 class="hero-title">Slides are React components</h1>
        <p class="hero-lead">
          Write the deck in TypeScript with the components you already have.
          Present it from the browser, export the PDF, and hand the same source
          to your coding agent.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/quickstart">Create a deck</a>
          <a class="button button-quiet" href="/introduction">Read the docs</a>
        </div>

        <div class="install">
          <fieldset class="install-tabs">
            <legend class="sr-only">Install for</legend>
            <label>
              <input
                checked
                class="switch-input"
                id="install-terminal"
                name="install"
                type="radio"
                value="terminal"
              />
              Your terminal
            </label>
            <label>
              <input
                class="switch-input"
                id="install-agent"
                name="install"
                type="radio"
                value="agent"
              />
              Your coding agent
            </label>
          </fieldset>

          <div class="install-panels">
            <figure class="code-figure install-panel" data-install="terminal">
              <Code
                code={installCode.terminal}
                defaultColor={false}
                lang="bash"
                themes={codeThemes}
              />
              <button
                aria-label="Copy the command"
                class="copy-button"
                data-copy={installCode.terminal}
                type="button"
              >
                <svg aria-hidden="true" class="copy-icon" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15">
                  <rect height="13" rx="2" width="13" x="9" y="9"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg aria-hidden="true" class="copied-icon" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                <span class="copied-label">Copied</span>
              </button>
            </figure>
            <figure class="code-figure install-panel" data-install="agent">
              <Code
                code={installCode.agent}
                defaultColor={false}
                lang="text"
                themes={codeThemes}
                wrap
              />
              <button
                aria-label="Copy the prompt"
                class="copy-button"
                data-copy={installCode.agent}
                type="button"
              >
                <svg aria-hidden="true" class="copy-icon" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15">
                  <rect height="13" rx="2" width="13" x="9" y="9"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg aria-hidden="true" class="copied-icon" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                <span class="copied-label">Copied</span>
              </button>
            </figure>
          </div>

          <div class="install-notes">
            <p class="install-note" data-install="terminal">
              Writes a Next.js app with a sample deck in it, installs it, and makes
              the first commit. Deckard is in preview: the API can still move
              before 1.0.
            </p>
            <p class="install-note" data-install="agent">
              Paste it into Claude Code, Cursor, or Codex. The agent runs the
              scaffold and picks up the deck from there.
            </p>
          </div>
        </div>
      </div>

      <div class="stage">
        <LiveDeck theme={stageTheme} />
      </div>
    </section>

    <section class="section" id="write">
      <div class="section-head">
        <p class="section-eyebrow">Author</p>
        <h2>Write slides in React</h2>
        <p>
          A deck is an array of slides in <code>deck/slides.tsx</code>. Each one
          is a React element: a layout Deckard ships, a chart you built, a
          running demo, or data a Server Component loaded. This is the deck
          above.
        </p>
      </div>

      <div class="demo">
        <div class="demo-viewer">
          <fieldset class="demo-steps">
            <legend class="sr-only">Slide</legend>
            {
              demoSteps.map((step, index) => (
                <label>
                  <input
                    checked={index === 0}
                    class="switch-input"
                    data-from={String(step.from)}
                    id={`demo-step-${index + 1}`}
                    name="demo-step"
                    type="radio"
                    value={String(index + 1)}
                  />
                  <span class="demo-step-number">{index + 1}</span>
                  {step.label}
                </label>
              ))
            }
          </fieldset>

          <div class="demo-panels">
            <figure class="demo-code">
              <figcaption>deck/slides.tsx</figcaption>
              <Code
                code={demoCode}
                defaultColor={false}
                lang="tsx"
                themes={codeThemes}
                transformers={[numberLines]}
              />
            </figure>

            <div class="demo-stage">
              <div class="demo-slides">
                {
                  demoSteps.map((step, index) => (
                    <img
                      alt={`${step.label}: the slide this entry renders`}
                      class="demo-slide"
                      data-step={String(index + 1)}
                      decoding="async"
                      height="720"
                      loading="lazy"
                      src={previewSrc(themePreviewPath(walkthroughTheme, step.slide, "light"))}
                      width="1280"
                    />
                  ))
                }
              </div>
              <div class="demo-captions">
                {
                  demoSteps.map((step, index) => (
                    <p class="demo-caption" data-step={String(index + 1)}>
                      {step.summary}
                    </p>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        {/*
         * One block per step, and between them the height the walkthrough
         * scrolls through. The script observes these and checks the matching
         * radio as each block reaches the middle of the screen; the panels above
         * stay put while they pass. The compact layout drops the track and its
         * height with it.
         */}
        <div aria-hidden="true" class="demo-track">
          {
            demoSteps.map((_step, index) => (
              <div class="demo-beat" data-step={String(index + 1)} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="patterns">
      <div class="section-head">
        <p class="section-eyebrow">Compose</p>
        <h2>Start from a slide pattern</h2>
        <p>
          Pick by what the slide has to do. Every block installs into your app as
          source, so the markup is yours to change.
        </p>
      </div>

      <SlidePatterns columns={3} />

      <p class="section-footnote">
        <a href="/slide-patterns">The pattern guide</a> maps every job to its
        blocks. Each picture opens that slide in the <a href={playgroundUrl}
          >feature deck</a
        >.
      </p>
    </section>

    <section class="section" id="themes">
      <div class="section-head">
        <p class="section-eyebrow">Style</p>
        <h2>Change the whole look with one import</h2>
        <p>
          A theme is one stylesheet on the canvas: type, spacing, surfaces, and
          backgrounds, in light and dark. Pick one to see it on the deck at the
          top of the page. Eject it when you want to edit the CSS.
        </p>
      </div>

      <ThemeGrid />

      <p class="section-footnote">
        <a href="/themes">The theme gallery</a> has every slide of the example in
        each theme, and the palette each one reads.
      </p>
    </section>

    <section class="section" id="canvas">
      <div class="feature">
        <div class="feature-copy">
          <p class="section-eyebrow">Canvas</p>
          <h2>One canvas on every screen</h2>
          <p>
            Every slide is drawn on a fixed {canvasSize} canvas that scales to
            fit. Nothing inside it reflows, so the laptop, the projector, the
            phone, and the PDF show the same layout.
          </p>
          <p>
            <code>deckard export pdf</code> prints that canvas through the same
            routes the deck runs on, one page per slide.
          </p>
        </div>

        <div class="canvas-demo">
          <figure class="canvas-demo-wide">
            <img
              alt="The figures slide at projector width"
              decoding="async"
              height="720"
              loading="lazy"
              src={previewSrc(themePreviewPath(walkthroughTheme, "figures", "dark"))}
              width="1280"
            />
            <figcaption>Projector</figcaption>
          </figure>
          <figure class="canvas-demo-narrow">
            <img
              alt="The same slide at phone width"
              decoding="async"
              height="720"
              loading="lazy"
              src={previewSrc(themePreviewPath(walkthroughTheme, "figures", "dark"))}
              width="1280"
            />
            <figcaption>Phone</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="present">
      <div class="feature feature-flip">
        <div class="feature-copy">
          <p class="section-eyebrow">Present</p>
          <h2>Presenter mode in a second window</h2>
          <p>
            <kbd>P</kbd> opens your notes, a timer, the slide you are on, and the
            next step, in a window the room never sees. Arrow keys walk the
            reveal steps on a slide before they move to the next one.
          </p>
        </div>

        <figure class="shot">
          <Image
            alt={presenterAlt}
            class="shot-image"
            loading="lazy"
            sizes="(min-width: 64rem) 44rem, 100vw"
            src={presenterImage}
            widths={[500, 750, 1000, 1500, presenterImage.width]}
          />
        </figure>
      </div>
    </section>

    <section class="section" id="export">
      <div class="feature">
        <div class="feature-copy">
          <p class="section-eyebrow">Ship</p>
          <h2>Checks before the room sees it</h2>
          <p>
            A fixed canvas does not scroll, so content that does not fit is
            clipped. Find those slides, review the deck as one contact sheet,
            and write the PDF.
          </p>
        </div>

        <figure class="code-figure">
          <figcaption>terminal</figcaption>
          <Code
            code={cliCode}
            defaultColor={false}
            lang="bash"
            themes={codeThemes}
          />
        </figure>
      </div>
    </section>

    <section class="section" id="agents">
      <div class="section-head">
        <p class="section-eyebrow">Automate</p>
        <h2>Hand the deck to an agent</h2>
        <p>
          A deck is a TypeScript array in a Next.js app, so an agent edits it the
          way it edits the rest of your code, and you review the change as a
          diff.
        </p>
      </div>

      <div class="agent-grid">
        <div class="agent-item">
          <h3>A skill</h3>
          <p>
            <code>npx skills add thebuilder/deckard</code> installs the
            slide-authoring skill: the blocks, when a slide earns its own file,
            the Server Component boundary, canvas sizing, and the token contract.
          </p>
        </div>
        <div class="agent-item">
          <h3>The docs in one file</h3>
          <p>
            <a href="/llms.txt">/llms.txt</a> indexes the site and <a
              href="/llms-full.txt">/llms-full.txt</a> carries every page, so
            the whole reference fits in a context window.
          </p>
        </div>
        <div class="agent-item">
          <h3>Checks it can run</h3>
          <p>
            <code>deckard validate</code> and <code>check-overflow</code> exit
            non-zero and name the slide. <code>contact-sheet</code> writes every
            slide into one image an agent can read back before you look.
          </p>
        </div>
      </div>
    </section>

    <section class="closing">
      <h2>Write the first slide</h2>
      <div class="hero-actions">
        <a class="button button-primary" href="/quickstart">Get started</a>
        <a class="button button-quiet" href="/introduction">Read the docs</a>
      </div>
    </section>
  </div>

  <footer class="landing-footer" slot="footer">
    <p>Deckard is MIT licensed.</p>
    <nav aria-label="Footer">
      <a href="/introduction">Introduction</a>
      <a href="/quickstart">Quickstart</a>
      <a href="/themes">Themes</a>
      <a href="/reference/cli">CLI</a>
      <a href="https://github.com/thebuilder/deckard">GitHub</a>
    </nav>
  </footer>
</PageLayout>

<script>
  /*
   * The stepped demo advances as the reader scrolls through it.
   *
   * The radio group stays the control. This writes `checked` and nothing else,
   * so the rules the page already generates do the switching, and a reader with
   * no script gets the same stepper. Nothing here moves focus.
   *
   * The query is the one the stylesheet lays the scroll track out under, third
   * condition included: without a script there is no track, so there is nothing
   * to observe and nothing to scroll through either.
   */
  const layout = matchMedia(
    "(min-width: 64rem) and (prefers-reduced-motion: no-preference) and (scripting: enabled)"
  )

  /* The middle tenth of the screen. A block is most of a screen tall, so one
   * covers that band at a time, and the one covering it is the step. */
  const band = "-45% 0px -45% 0px"

  const covering = new Set<Element>()

  let observer: IntersectionObserver | null = null

  const disconnect = () => {
    observer?.disconnect()
    observer = null
    covering.clear()
  }

  /* The array is taller than its panel on most screens, so the panel scrolls
   * the lit entry near its top whenever the step changes. */
  const reveal = (demo: Element) => {
    const checked = demo.querySelector<HTMLInputElement>(
      ".demo-steps input:checked"
    )
    const pre = demo.querySelector<HTMLElement>(".demo-code pre")
    const first = pre?.querySelector<HTMLElement>(
      `.line[data-line="${checked?.dataset.from}"]`
    )

    if (!(pre && first) || pre.scrollHeight <= pre.clientHeight) {
      return
    }

    pre.scrollTo({
      behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
        ? "auto"
        : "smooth",
      top: Math.max(0, first.offsetTop - pre.clientHeight * 0.15),
    })
  }

  const connect = () => {
    const demo = document.querySelector(".demo")
    const beats = demo?.querySelectorAll<HTMLElement>(".demo-beat")

    if (demo == null || beats == null || beats.length === 0) {
      return
    }

    const steps = demo.querySelector(".demo-steps")

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            covering.add(entry.target)
          } else {
            covering.delete(entry.target)
          }
        }

        /* A reader who has just picked a step with the keyboard keeps it until
         * they leave the group. Scrolling never moves focus, and it does not
         * overrule someone who has it either. */
        if (steps?.contains(document.activeElement)) {
          return
        }

        /* Two beats meet inside the band for one frame at the handover. The
         * upper one holds it until it has left, so the step does not flicker. */
        for (const beat of beats) {
          if (covering.has(beat)) {
            const radio = demo.querySelector<HTMLInputElement>(
              `#demo-step-${beat.dataset.step}`
            )

            if (radio != null && !radio.checked) {
              radio.checked = true
              reveal(demo)
            }

            return
          }
        }
      },
      { rootMargin: band }
    )

    for (const beat of beats) {
      observer.observe(beat)
    }
  }

  const sync = () => {
    disconnect()

    const demo = document.querySelector<HTMLElement>(".demo")

    if (demo && demo.dataset.wired !== "true") {
      demo.dataset.wired = "true"
      demo.querySelector(".demo-steps")?.addEventListener("change", () => {
        reveal(demo)
      })
    }

    if (layout.matches) {
      connect()
    }
  }

  layout.addEventListener("change", sync)

  /* The install panels copy their text and say so for a moment. */
  const copiedMs = 1600

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null
    const button = target?.closest<HTMLButtonElement>("[data-copy]")

    if (!button?.dataset.copy) {
      return
    }

    navigator.clipboard.writeText(button.dataset.copy).then(
      () => {
        button.dataset.copied = ""
        window.setTimeout(() => {
          delete button.dataset.copied
        }, copiedMs)
      },
      () => undefined
    )
  })

  // The client router swaps the document without re-running this module.
  document.addEventListener("astro:page-load", sync)

  sync()
</script>
