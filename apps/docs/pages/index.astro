---
import { Image } from "astro:assets"
import { Code } from "astro:components"
import data from "blume:data"
import PageLayout from "blume/components/layout/PageLayout.astro"
import presenterImage from "../assets/presenter.png"
import DeckPreview from "../components/DeckPreview.astro"
import HeroBackground from "../components/HeroBackground.astro"
import LiveSlidePreview from "../components/LiveSlidePreview.astro"
import SlidePatterns from "../components/SlidePatterns.astro"
import type { HeroVariantId } from "../components/hero/hero-effect"
import {
  defaultTheme,
  galleryTheme,
  themeCountWord,
  themeNames,
} from "../lib/deck-preview"
import {
  canvas,
  cliCode,
  demoBackgrounds,
  demoCode,
  demoSteps,
  heroSlide,
  installCode,
} from "../lib/landing"
import "../styles/landing.css"

const { config } = data

const playgroundUrl = "https://deckard-playground.thebuilder.dk"
const examplePreviewPaths = [
  "/example/opening",
  "/example/figures",
  "/example/decision",
  "/example/close",
] as const

/* The effect behind the hero. */
const heroVariant: HeroVariantId = "esper-scan"
const canvasSize = `${canvas.width}x${canvas.height}`

const presenterAlt =
  "The presenter window: a timer and a clock, a preview of the next step, the deck listed by title with the current slide picked out, the slide itself, and the speaker notes under it."

const codeThemes = {
  dark: "github-dark-high-contrast",
  light: "github-light-high-contrast",
} as const

// Shiki emits one <span class="line"> per line. Numbering them is what lets the
// generated rules below light one slide object and dim the rest, with no script.
const numberLines = {
  line(node: { properties: Record<string, unknown> }, line: number) {
    node.properties["data-line"] = String(line)
  },
  name: "deckard-line-number",
}

const lineStep = 26

const stateRules = demoSteps
  .map((step, index) => {
    const id = `#demo-step-${index + 1}`
    const range = `:nth-child(n + ${step.from}):nth-child(-n + ${step.to})`

    const active = `.demo:has(${id}:checked)`

    return [
      `${active} .line:not(${range}) { opacity: 0.42 }`,
      `${active} .demo-slide[data-step="${index + 1}"] { display: block }`,
      // visibility, not display: the four captions are stacked in one grid
      // cell, so the hidden three are what hold the slide above them still.
      `${active} .demo-caption[data-step="${index + 1}"] { visibility: visible }`,
    ].join("\n")
  })
  .join("\n")

// The reveal lives inside the motion query rather than being switched off by a
// later rule, because the generated selectors below outrank anything static.
const motionRules = demoSteps
  .map((step, index) =>
    Array.from(
      { length: step.to - step.from + 1 },
      (_, offset) =>
        `.demo:has(#demo-step-${index + 1}:checked) .line:nth-child(${step.from + offset}) { animation-name: demo-line-in; animation-delay: ${offset * lineStep}ms }`
    ).join("\n")
  )
  .join("\n")

const themeRules = themeNames
  .map(
    (name) =>
      `.theme-stage:has(#pick-theme-${name}:checked) .theme-frame[data-theme-name="${name}"] { display: block }`
  )
  .join("\n")

const pageRules = `${themeRules}
${stateRules}
@media (prefers-reduced-motion: no-preference) {
${motionRules}
}`
---

<PageLayout
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{
    description: `Build presentations in React from editable slide patterns, with a fixed ${canvasSize} canvas, presenter tools, themes, and PDF export.`,
    title: "Deckard, presentations built with React",
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
>
  <style is:inline set:html={pageRules}></style>

  <div class="landing">
    <section class="hero" data-hero-state="idle" data-hero-variant={heroVariant}>
      <HeroBackground variant={heroVariant} />

      <div class="hero-inner">
        <h1 class="hero-title">Slides are React components</h1>
        <p class="hero-lead">
          Start with editable slide patterns and a theme. Add your own React when
          the talk needs a chart, a live demo, or data loaded by Next.js. Present
          from the browser, export the PDF, and hand the same source to your coding
          agent.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/quickstart"> Create a deck </a>
          <a class="button button-quiet" href="/slide-patterns">
            Browse slide patterns
          </a>
          <a class="button button-quiet" href={`${playgroundUrl}/example`}>View the example deck</a>
        </div>

        <div aria-label="A four-slide Deckard presentation" class="hero-deck-strip" role="img">
          {examplePreviewPaths.map((href) => (
            <LiveSlidePreview href={href} title="Example Deckard slide" />
          ))}
        </div>

        <div class="install">
          <fieldset class="install-tabs">
            <legend class="sr-only">Install for</legend>
            <label>
              <input
                checked
                class="switch-input"
                id="install-terminal"
                name="install"
                type="radio"
                value="terminal"
              />
              Your terminal
            </label>
            <label>
              <input
                class="switch-input"
                id="install-agent"
                name="install"
                type="radio"
                value="agent"
              />
              Your coding agent
            </label>
          </fieldset>

          <div class="install-panels">
            <figure class="code-figure install-panel" data-install="terminal">
              <Code
                code={installCode.terminal}
                defaultColor={false}
                lang="bash"
                themes={codeThemes}
              />
            </figure>
            <figure class="code-figure install-panel" data-install="agent">
              <Code
                code={installCode.agent}
                defaultColor={false}
                lang="text"
                themes={codeThemes}
                wrap
              />
            </figure>
          </div>

          <div class="install-notes">
            <p class="install-note" data-install="terminal">
              Writes a Next.js app with a sample deck in it, installs it, and makes
              the first commit. Deckard is in preview: the API can still move
              before 1.0.
            </p>
            <p class="install-note" data-install="agent">
              Paste it into Claude Code, Cursor, or Codex. The agent runs the
              scaffold and picks up the deck from there.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="patterns">
      <div class="section-head">
        <h2>Start with a slide pattern</h2>
        <p>
          Choose by what the slide needs to do. Each recipe pairs a whole-slide
          frame with the content block that fits inside it, and every block lands
          in your app as editable source.
        </p>
      </div>

      <SlidePatterns />

      <p class="section-footnote">
        <a href="/slide-patterns">Open the pattern guide</a> for composition rules
        and the full intent index. <a href={playgroundUrl}>Explore every Deckard feature</a>
        in the reference deck.
      </p>
    </section>

    <section class="section section-lead" id="write">
      <div class="section-head">
        <h2>Write slides in React</h2>
        <p>
          Your own components, or the layouts Deckard ships. A chart, a table, a
          code sample, a video, a running demo, data Next.js loaded for you.
          Pick a slide to see the code behind it.
        </p>
      </div>

      <div class="demo">
        <div class="demo-viewer">
          <fieldset class="demo-steps">
            <legend class="sr-only">Slide</legend>
            {
              demoSteps.map((step, index) => (
                <label>
                  <input
                    checked={index === 0}
                    class="switch-input"
                    id={`demo-step-${index + 1}`}
                    name="demo-step"
                    type="radio"
                    value={String(index + 1)}
                  />
                  <span class="demo-step-number">{index + 1}</span>
                  {step.label}
                </label>
              ))
            }
          </fieldset>

          <div class="demo-panels">
            <figure class="demo-code">
              <figcaption>deck/slides.tsx</figcaption>
              <Code
                code={demoCode}
                defaultColor={false}
                lang="tsx"
                themes={codeThemes}
                transformers={[numberLines]}
              />
            </figure>

            <div class="demo-stage">
              {
                demoSteps.map((step, index) => (
                  <div class="demo-slide" data-step={String(index + 1)}>
                    <DeckPreview
                      background={demoBackgrounds[index]}
                      mode="light"
                      scale={0.17}
                      slide={step.slide}
                      theme={defaultTheme}
                    />
                  </div>
                ))
              }
              <div class="demo-captions">
                {
                  demoSteps.map((step, index) => (
                    <p class="demo-caption" data-step={String(index + 1)}>
                      {step.summary}
                    </p>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        {/*
         * One block per step, and between them the height the walkthrough
         * scrolls through. The script observes these and checks the matching
         * radio as each block reaches the middle of the screen; the panels above
         * stay put while they pass. The step's own prose is the caption under
         * the slide, so there is nothing to read down here, and the compact
         * layout drops the track and its height with it.
         */}
        <div aria-hidden="true" class="demo-track">
          {
            demoSteps.map((_step, index) => (
              <div class="demo-beat" data-step={String(index + 1)} />
            ))
          }
        </div>
      </div>

      <p class="section-footnote">
        Server and client components are both supported.
      </p>
    </section>

    <section class="section" id="canvas">
      <div class="section-head">
        <h2>One layout everywhere</h2>
        <p>
          Every slide is drawn on one fixed {canvasSize} canvas that scales to fit
          the screen. Nothing inside it reflows, so the two frames below are the
          same slide at two widths. Present, screenshot, and export a PDF from
          that layout.
        </p>
      </div>

      <div class="canvas-demo">
        <figure class="canvas-demo-wide">
          <DeckPreview
            mode="dark"
            scale={0.17}
            slide={demoSteps[1].slide}
            theme="meridian"
          />
          <figcaption>A projector</figcaption>
        </figure>
        <figure class="canvas-demo-narrow">
          <DeckPreview
            mode="dark"
            scale={0.0875}
            slide={demoSteps[1].slide}
            theme="meridian"
          />
          <figcaption>A phone</figcaption>
        </figure>
      </div>

      <p class="section-footnote">
        <code>deckard export pdf</code> prints that canvas through the same slide
        routes the deck runs on, one page per slide.
      </p>
    </section>

    <section class="section" id="present">
      <div class="section-head">
        <h2>Present from the browser</h2>
        <p>
          Arrow keys walk the reveal steps on a slide and then move to the next
          one. <code>P</code> opens presenter mode in a second window: your notes,
          a timer, the slide you are on, and what comes next.
        </p>
      </div>

      <figure class="shot">
        <Image
          alt={presenterAlt}
          class="shot-image"
          loading="lazy"
          sizes="(min-width: 66rem) 62rem, 100vw"
          src={presenterImage}
          widths={[500, 750, 1000, 1500, presenterImage.width]}
        />
        <figcaption>Presenter mode, on the second screen.</figcaption>
      </figure>
    </section>

    <section class="section" id="themes">
      <div class="section-head">
        <h2>Start with a theme</h2>
        <p>
          Pick a built-in and switch with one import. Eject it when you want to
          edit the CSS. Blocks install into your app as source, so their markup
          is yours to change.
        </p>
      </div>

      <div class="theme-stage">
        <div class="theme-frames">
          {
            themeNames.map((name) => (
              <div class="theme-frame" data-theme-name={name}>
                <DeckPreview
                  background={galleryTheme[name].background}
                  mode={galleryTheme[name].defaultColorMode === "dark" ? "dark" : "light"}
                  scale={0.24}
                  slide={heroSlide}
                  theme={name}
                />
              </div>
            ))
          }
        </div>

        <fieldset class="theme-picker">
          <legend class="sr-only">Deck theme</legend>
          {
            themeNames.map((name, index) => (
              <label>
                <input
                  checked={index === 0}
                  class="switch-input"
                  id={`pick-theme-${name}`}
                  name="pick-theme"
                  type="radio"
                  value={name}
                />
                {name}
              </label>
            ))
          }
        </fieldset>
      </div>

      <p class="section-footnote">
        One deck, {themeCountWord} themes. <a href="/themes">
          Open the gallery
        </a> for each of them in light and dark.
      </p>
    </section>

    <section class="section" id="export">
      <div class="section-head">
        <h2>Check and export</h2>
        <p>
          A fixed canvas does not scroll, so content that does not fit is
          clipped. Find those slides, review the whole deck as a contact sheet,
          and produce the PDF.
        </p>
      </div>

      <figure class="code-figure code-figure-wide">
        <figcaption>terminal</figcaption>
        <Code
          code={cliCode}
          defaultColor={false}
          lang="bash"
          themes={codeThemes}
        />
      </figure>
    </section>

    <section class="section" id="agents">
      <div class="section-head">
        <h2>Hand the deck to an agent</h2>
        <p>
          A deck is a TypeScript array in a Next.js app, so an agent edits it the
          way it edits the rest of your code. What it needs to do that well ships
          with Deckard.
        </p>
      </div>

      <div class="agent-grid">
        <div class="agent-item">
          <h3>A skill</h3>
          <p>
            <code>npx skills add thebuilder/deckard</code> installs the
            slide-authoring skill: the blocks, when a slide earns its own file,
            the Server Component boundary, canvas sizing, and the token contract.
          </p>
        </div>
        <div class="agent-item">
          <h3>The docs in one file</h3>
          <p>
            <a href="/llms.txt">/llms.txt</a> indexes the site and <a
              href="/llms-full.txt">/llms-full.txt</a> carries every page, so
            the whole reference fits in a context window.
          </p>
        </div>
        <div class="agent-item">
          <h3>Checks it can run</h3>
          <p>
            <code>deckard validate</code> and <code>check-overflow</code> exit
            non-zero and name the slide. <code>contact-sheet</code> writes every
            slide into one image an agent can read back before you look.
          </p>
        </div>
      </div>
    </section>

    <section class="closing">
      <h2>Write the first slide</h2>
      <div class="hero-actions">
        <a class="button button-primary" href="/quickstart"> Get started </a>
        <a class="button button-quiet" href="/introduction"> Read the docs </a>
      </div>
    </section>
  </div>

  <footer class="landing-footer" slot="footer">
    <p>Deckard is MIT licensed.</p>
    <nav aria-label="Footer">
      <a href="/introduction">Introduction</a>
      <a href="/quickstart">Quickstart</a>
      <a href="/themes">Themes</a>
      <a href="/reference/cli">CLI</a>
      <a href="https://github.com/thebuilder/deckard">GitHub</a>
    </nav>
  </footer>
</PageLayout>

<script>
  /*
   * The stepped demo advances as the reader scrolls through it.
   *
   * The radio group stays the control. This writes `checked` and nothing else,
   * so the rules the page already generates do the switching, and a reader with
   * no script gets the same stepper they get today. Nothing here moves focus.
   *
   * The query is the one the stylesheet lays the scroll track out under, third
   * condition included: without a script there is no track, so there is nothing
   * to observe and nothing to scroll through either.
   */
  const layout = matchMedia(
    "(min-width: 64rem) and (prefers-reduced-motion: no-preference) and (scripting: enabled)"
  )

  /* The middle tenth of the screen. A block is most of a screen tall, so one
   * covers that band at a time, and the one covering it is the step. */
  const band = "-45% 0px -45% 0px"

  const covering = new Set<Element>()

  let observer: IntersectionObserver | null = null

  const disconnect = () => {
    observer?.disconnect()
    observer = null
    covering.clear()
  }

  const connect = () => {
    const demo = document.querySelector(".demo")
    const beats = demo?.querySelectorAll<HTMLElement>(".demo-beat")

    if (demo == null || beats == null || beats.length === 0) {
      return
    }

    const steps = demo.querySelector(".demo-steps")

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            covering.add(entry.target)
          } else {
            covering.delete(entry.target)
          }
        }

        /* A reader who has just picked a step with the keyboard keeps it until
         * they leave the group. Scrolling never moves focus, and it does not
         * overrule someone who has it either. */
        if (steps?.contains(document.activeElement)) {
          return
        }

        /* Two beats meet inside the band for one frame at the handover. The
         * upper one holds it until it has left, so the step does not flicker. */
        for (const beat of beats) {
          if (covering.has(beat)) {
            const radio = demo.querySelector<HTMLInputElement>(
              `#demo-step-${beat.dataset.step}`
            )

            if (radio != null && !radio.checked) {
              radio.checked = true
            }

            return
          }
        }
      },
      { rootMargin: band }
    )

    for (const beat of beats) {
      observer.observe(beat)
    }
  }

  const sync = () => {
    disconnect()

    if (layout.matches) {
      connect()
    }
  }

  layout.addEventListener("change", sync)

  // The client router swaps the document without re-running this module.
  document.addEventListener("astro:page-load", sync)

  sync()
</script>
