---
interface Props {
  href: string
  title: string
}

const { href, title } = Astro.props
const origin =
  import.meta.env.PUBLIC_PLAYGROUND_URL ??
  (import.meta.env.DEV
    ? "http://localhost:3000"
    : "https://deckard-playground.thebuilder.dk")
const separator = href.includes("?") ? "&" : "?"
const src = `${origin}${href}${separator}presenterPreview=1`
---

<div class="live-slide-preview not-prose">
  <iframe aria-hidden="true" loading="lazy" src={src} tabindex="-1" title={title}></iframe>
</div>

<style>
  .live-slide-preview {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d1117;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>
